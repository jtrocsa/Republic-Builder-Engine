{
  "name": "republic-builder-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate:content": "node scripts/validate-content.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "maps:build": "node scripts/generate-caribbean-tmj.js && node scripts/generate-riverbend-tmj.js && node scripts/generate-common-cause-tmj.js && node scripts/generate-institute-hall-tmj.js && node scripts/generate-archive-room-tmj.js apps/web/src/content/maps/archive-room.tmj && node scripts/generate-hallway-tmj.js apps/web/src/content/maps/hallway.tmj",
    "assets:audit": "node scripts/assets/audit.js",
    "assets:label": "node scripts/assets/label-tilesheet.js",
    "assets:measure": "node scripts/assets/measure-sprite.js",
    "assets:pack-objects": "node scripts/assets/pack-objects.js",
    "assets:optimize:waldseemuller": "node scripts/assets/optimize-waldseemuller.js",
    "assets:normalize-sprites": "node scripts/assets/normalize-sprite-frames.js",
    "assets:preview-map": "node scripts/assets/preview-map.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "csv-stringify": "^6.8.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "picomatch": "^4.0.5",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@supabase/supabase-js": "^2.58.0"
  }
}
